# CPU preparation only. Copy outside the checkout and edit before submitting.
FD_ROOT="/home/${USER}/facdigger"
FD_CODE_ROOT="$FD_ROOT/code"
FD_PYTHON="$FD_CODE_ROOT/.venv/bin/python"
FD_LOG_ROOT="$FD_ROOT/logs"
FD_PARTITION=Teaching
FD_ACCOUNT=teaching
FD_QOS=teaching
FD_CPUS=4
FD_MEMORY=32G
FD_TIME=04:00:00

# plan: account quota + listing metadata only; ingest: full historical download;
# prepare: CPU feature/label calculation and three verified fold snapshots.
FD_DATA_MODE=plan
FD_DATA_CONFIG="$FD_ROOT/configs/eodhd.yaml"
FD_RESEARCH_CONFIG="$FD_ROOT/configs/transformer.yaml"
FD_RUNTIME="$FD_ROOT/configs/runtime.yaml"
FD_PREPARE_OUTPUT="$FD_ROOT/inputs/transformer"
FD_CREDENTIAL_FILE="$FD_ROOT/secrets/eodhd.env"
FD_RESERVE_API_CALLS=10000
FD_REQUESTS_PER_MINUTE=300
