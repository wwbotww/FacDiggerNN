# Copy outside the repository and set stable Lustre paths before submission.
FD_ROOT="/home/${USER}/facdigger"
FD_CODE_ROOT="$FD_ROOT/code"
FD_PYTHON="$FD_CODE_ROOT/.venv/bin/python"
FD_LOG_ROOT="$FD_ROOT/logs"
FD_PARTITION=Teaching
FD_ACCOUNT=teaching
FD_QOS=teaching
FD_GRES=gpu:h200_1g.18gb:1
FD_CPUS=2
FD_MEMORY=20G
FD_TIME=04:00:00

# finance-transformer | finance-pretrain | transformer-run
FD_MODE=finance-transformer
FD_CONFIG="$FD_CODE_ROOT/configs/experiments/finance_patch_transformer_scratch.yaml"
FD_RUNTIME="$FD_CODE_ROOT/configs/deployment/icf/runtime.example.yaml"
FD_RESOURCE_BUDGET="$FD_CODE_ROOT/configs/deployment/icf/budget.example.yaml"
# Replace these paths with verified assets and a unique logical run name.
FD_DATASET="$FD_ROOT/inputs/snapshots/REPLACE_WITH_DATASET_ID"
FD_RUN_DIR="$FD_ROOT/artifacts/REPLACE_WITH_RUN_NAME"
# Empty means read persistent inputs directly. Optional node-local staging:
FD_STAGING_ROOT=""
FD_MIN_OUTPUT_FREE_BYTES=2147483648

# Manual continuation first. --requeue still permits scheduler preemption recovery.
FD_AUTO_REQUEUE=0
FD_MAX_ATTEMPTS=10
FD_MAX_TOTAL_SECONDS=1209600
FD_MAX_NO_PROGRESS=2
